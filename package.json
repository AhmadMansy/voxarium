{
  "name": "voxarium",
  "productName": "Voxarium",
  "version": "0.1.0",
  "description": "A private, on-device text-to-speech studio with many local voice models.",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Voxarium contributors",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/AhmadMansy/voxarium",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AhmadMansy/voxarium.git"
  },
  "bugs": {
    "url": "https://github.com/AhmadMansy/voxarium/issues"
  },
  "keywords": [
    "tts",
    "text-to-speech",
    "local-first",
    "offline",
    "electron",
    "voice"
  ],
  "scripts": {
    "sync:phonon": "node scripts/sync-phonon.mjs",
    "postinstall": "node scripts/sync-phonon.mjs",
    "catalog": "node scripts/fetch-catalog.mjs",
    "icon": "node scripts/make-icon.mjs",
    "dev": "concurrently -k -n renderer,electron -c cyan,magenta \"vite\" \"wait-on http://127.0.0.1:5174 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5174 electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-models.mjs",
    "test:models": "node scripts/test-models.mjs",
    "test:e2e": "node scripts/test-electron.mjs",
    "test:integrations": "node scripts/test-integrations.mjs",
    "voxarium": "node electron/cli/voxarium.cjs",
    "notices": "node scripts/gen-notices.mjs",
    "shots": "node scripts/shots.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "pack": "npm run build && electron-builder --publish never",
    "pack:win": "npm run build && electron-builder --win --x64 --publish never",
    "pack:linux": "npm run build && electron-builder --linux --x64 --publish never",
    "pack:mac": "npm run build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "phonon-tts": "^0.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "40.9.3",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.voxarium.app",
    "productName": "Voxarium",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "copyright": "Copyright © Voxarium contributors. Licensed under AGPL-3.0-or-later.",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "electron/sidecars/**",
      "electron/cli/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "linux": {
      "category": "AudioVideo",
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "maintainer": "Voxarium contributors <AhmadMansy@users.noreply.github.com>",
      "synopsis": "Private, on-device text-to-speech studio"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Voxarium"
    }
  }
}
